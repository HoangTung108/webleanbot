# Default: Leanbot Cloud, identical to the legacy IDE. Works on static hosting.
# VITE_LEANBOT_COMPILER_SERVER=cs.leanbot.space

# Optional self-hosted Arduino CLI compiler. Must be a backend accepting POST,
# not the static frontend address. Leave unset to use Leanbot Cloud.
# VITE_COMPILER_API=http://localhost:8787
# LEANBOT_LIBRARY_PATH=/absolute/path/to/Arduino/libraries
# ARDUINO_CLI=/absolute/path/to/arduino-cli

# Multi-Robot WebSocket Server URL
# Development: npm run dev starts the network server; Vite proxies /ws.
# Production: reverse-proxy /ws to the backend on the same HTTPS host,
# or set the WSS URL of a separately deployed backend (static hosts need this).
# VITE_WEBSOCKET_URL=wss://your-network-server.example/ws
